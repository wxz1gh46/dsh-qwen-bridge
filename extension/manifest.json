{
  "manifest_version": 3,
  "name": "Harness 网页桥接（Qwen / DeepSeek）",
  "version": "0.3.0",
  "description": "将本机 Harness 任务送到已登录的网页（Qwen 国际版 / DeepSeek），并回传文本及工具指令。",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:3081/*",
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://chat.qwen.ai/*", "https://chat.deepseek.com/*"], "js": ["sites/index.js", "render-clock.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://chat.qwen.ai/*", "https://chat.deepseek.com/*"], "js": ["sites/index.js", "records.js", "page.js", "inspect.js", "repair.js", "content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Harness 网页桥接", "default_popup": "popup.html" }
}
